# Public configuration. Browser-wallet connections work without WalletConnect.
NEXT_PUBLIC_SITE_URL=https://lumexa-aiwallet.vercel.app
# Optional: set a real Reown project ID to enable WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Mainnet is the default. Vercel production always builds for mainnet.
# Use testnet only in a separate local/preview environment.
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_MAINNET_ENABLED=true
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io
NEXT_PUBLIC_ARC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_MAINNET_EURC_ADDRESS=0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1
NEXT_PUBLIC_ARC_MAINNET_CIRBTC_ADDRESS=0x171A4217b86A807A64eB94757Db6849fb4bDbAA0
NEXT_PUBLIC_ETHEREUM_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Separate testnet environment (never mix its balances/history with mainnet).
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.io
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Real AI chat (server-only). On Vercel, the AI SDK uses runtime OIDC automatically.
# Local development: provide an AI Gateway key or use vercel env pull for OIDC.
# Access/credits must be available for the linked Vercel team.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-6-sol
